rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isCoordinator() {
      return signedIn() && hasProfile()
        && profile().role == 'coordinator' && profile().status == 'active';
    }
    function isActiveVolunteer() {
      return signedIn() && hasProfile()
        && profile().role == 'volunteer' && profile().status == 'active';
    }
    // Profesional de apoyo psicológico. Solo cuenta si coordinación ya lo activó.
    function isPsychologist() {
      return signedIn() && hasProfile()
        && profile().role == 'psychologist' && profile().status == 'active';
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Perfil público: nombre, rol, estado y disponibilidad (sin teléfonos ni documentos).
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && uid() == userId
        && request.resource.data.role in ['elderly', 'volunteer', 'psychologist']
        // Voluntarios y psicólogos nacen "pending": solo coordinación los activa.
        && request.resource.data.status ==
           (request.resource.data.role in ['volunteer', 'psychologist'] ? 'pending' : 'active')
        && request.resource.data.get('emailVerified', false) == false;
      allow update: if signedIn() && (
        // RF3: coordinación no puede activar a un voluntario pendiente si su correo no está verificado.
        (isCoordinator()
          && (!(resource.data.role == 'volunteer' && resource.data.status == 'pending'
                && request.resource.data.status == 'active')
              || (resource.data.get('emailVerified', false) == true
                  && resource.data.get('identityVerified', false) == true)))
        || (uid() == userId
            && request.resource.data.role == resource.data.role
            && (!request.resource.data.get('identityVerified', false)
                || request.resource.data.get('identityVerified', false)
                    == resource.data.get('identityVerified', false))
            && (!request.resource.data.get('volunteerPresentationReviewed', false)
                || request.resource.data.get('volunteerPresentationReviewed', false)
                    == resource.data.get('volunteerPresentationReviewed', false))
            && (request.resource.data.status == resource.data.status
                || request.resource.data.status == 'deleted')
            // RF3: solo se puede marcar el correo como verificado si Firebase lo certifica.
            && (request.resource.data.get('emailVerified', false) == resource.data.get('emailVerified', false)
                || (request.resource.data.get('emailVerified', false) == true
                    && request.auth.token.email_verified == true)))
        // Al terminar una llamada se actualiza al voluntario (disponibilidad y última llamada).
        || (resource.data.role == 'volunteer' && changedOnly(['available', 'lastCallAt']))
      );
    }

    // Datos personales: solo la propia persona y coordinación.
    match /private/{userId} {
      allow read: if signedIn() && (uid() == userId || isCoordinator());
      allow create, update, delete: if signedIn() && uid() == userId;
    }

    // Token privado del dispositivo para notificaciones al voluntario.
    // El servicio de envío lo lee desde el backend, nunca desde otras cuentas.
    match /pushTokens/{userId} {
      allow read: if signedIn() && uid() == userId;
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 4096;
      allow delete: if signedIn() && uid() == userId;
    }

    match /requests/{requestId} {
      allow read: if signedIn() && (
        resource.data.elderlyId == uid()
        || resource.data.volunteerId == uid()
        || isCoordinator()
        // Respaldo por código: un voluntario activo puede buscar solicitudes abiertas.
        || (isActiveVolunteer() && resource.data.status in ['searching', 'ringing'])
      );
      allow create: if signedIn() && request.resource.data.elderlyId == uid();
      allow update: if signedIn() && (
        resource.data.elderlyId == uid()
        || resource.data.volunteerId == uid()
        || isCoordinator()
        || (isActiveVolunteer()
            && resource.data.status in ['searching', 'ringing']
            && request.resource.data.volunteerId == uid())
      );
      // Coordinación puede anonimizar registros vencidos sin editar otros campos.
      allow update: if isCoordinator()
        && changedOnly(['elderlyId', 'volunteerId', 'roomName', 'joinCode']);
    }

    // Apoyo psicológico: el voluntario pide que un psicólogo se una a su llamada en curso.
    match /supportRequests/{id} {
      // Solo se puede pedir apoyo para una llamada propia, conectada y con esa misma sala.
      allow create: if isActiveVolunteer()
        && request.resource.data.requestedById == uid()
        && request.resource.data.status == 'open'
        && request.resource.data.get('psychologistId', null) == null
        && get(/databases/$(database)/documents/requests/$(request.resource.data.callId)).data.volunteerId == uid()
        && get(/databases/$(database)/documents/requests/$(request.resource.data.callId)).data.status == 'connected'
        && get(/databases/$(database)/documents/requests/$(request.resource.data.callId)).data.roomName
           == request.resource.data.roomName;
      allow read: if isCoordinator() || isPsychologist()
        || (signedIn() && resource.data.requestedById == uid());
      // El voluntario puede cancelar su solicitud mientras nadie la haya tomado.
      allow update: if signedIn() && resource.data.requestedById == uid()
        && resource.data.status == 'open'
        && request.resource.data.status == 'cancelled'
        && changedOnly(['status', 'closedAt']);
      // Un psicólogo la toma (solo si sigue abierta) y luego la cierra.
      allow update: if isPsychologist()
        && resource.data.status == 'open'
        && request.resource.data.status == 'accepted'
        && request.resource.data.psychologistId == uid()
        && changedOnly(['status', 'psychologistId', 'acceptedAt']);
      allow update: if isPsychologist()
        && resource.data.psychologistId == uid()
        && resource.data.status == 'accepted'
        && request.resource.data.status == 'closed'
        && changedOnly(['status', 'closedAt']);
      // Coordinación anonimiza solicitudes vencidas (F18.7).
      allow update: if isCoordinator()
        && changedOnly(['requestedById', 'elderlyId', 'roomName', 'psychologistId', 'note']);
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == uid();
      allow read: if signedIn() && (resource.data.reporterId == uid() || isCoordinator());
      allow update: if isCoordinator();
      // Anonimización de reportes vencidos (F18.7).
      allow update: if isCoordinator()
        && changedOnly(['reporterId', 'reportedId', 'comment']);
    }

    match /alerts/{alertId} {
      allow create: if signedIn()
        && request.resource.data.triggeredById == uid()
        && request.resource.data.get('status', 'open') == 'open';
      allow read: if signedIn() && (resource.data.triggeredById == uid() || isCoordinator());
      allow update: if isCoordinator()
        && changedOnly([
          'status', 'takenById', 'takenAt',
          'familyNotifiedAt', 'familyChannel', 'familyOutcome',
          'alternateNotifiedAt', 'alternateOutcome',
          'resolvedAt', 'resolvedById', 'resolutionNote',
          'triggeredById', 'elderlyId', 'note'
        ]);
    }

    match /auditLogs/{id} {
      allow create, read: if isCoordinator();
      allow update, delete: if false;
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isCoordinator();
    }

    match /dataRequests/{id} {
      allow create: if signedIn();
      allow read: if isCoordinator();
      allow update, delete: if false;
    }

    match /surveys/{surveyId} {
      allow create, update: if signedIn() && request.resource.data.userId == uid();
      allow read: if signedIn() && (resource.data.userId == uid() || isCoordinator());
    }

    // Evidencia del consentimiento: se crea una vez y no se modifica ni se borra.
    match /consents/{userId} {
      allow create: if signedIn() && uid() == userId;
      allow read: if signedIn() && (uid() == userId || isCoordinator());
    }

    // Evidencia separada de la autorización opcional para publicar la presentación del voluntario.
    match /presentationConsents/{userId} {
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.userId == uid()
        && request.resource.data.authorized is bool
        && request.resource.data.consentVersion is string
        && request.resource.data.updatedAt is string;
      allow read: if signedIn() && (uid() == userId || isCoordinator());
      allow delete: if false;
    }

    match /identityConsents/{userId} {
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.userId == uid()
        && request.resource.data.authorized is bool
        && request.resource.data.consentVersion is string
        && request.resource.data.updatedAt is string;
      allow read: if signedIn() && (uid() == userId || isCoordinator());
      allow delete: if false;
    }

    match /slots/{slotId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.volunteerId == uid();
      allow update: if signedIn()
        && resource.data.volunteerId == uid() && request.resource.data.volunteerId == uid();
      allow delete: if signedIn() && resource.data.volunteerId == uid();
    }

    // Contador de intentos fallidos (RF23). Solo es un aviso de la app: la protección real
    // contra fuerza bruta la hace Firebase Auth en el servidor. Se puede leer un documento
    // concreto antes de iniciar sesión, pero NO listar la colección, y solo se aceptan los
    // dos campos esperados. Borrarlo exige sesión iniciada.
    match /locks/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['failedAttempts', 'lockedUntil'])
        && request.resource.data.failedAttempts is int
        && request.resource.data.failedAttempts >= 0
        && request.resource.data.failedAttempts <= 10
        && (request.resource.data.lockedUntil == null || request.resource.data.lockedUntil is string);
      allow delete: if signedIn();
    }
  }
}
