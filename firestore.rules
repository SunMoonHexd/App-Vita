rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isCoordinator() {
      return signedIn() && hasProfile()
        && profile().role == 'coordinator' && profile().status == 'active';
    }
    function isActiveVolunteer() {
      return signedIn() && hasProfile()
        && profile().role == 'volunteer' && profile().status == 'active';
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Perfil público: nombre, rol, estado y disponibilidad (sin teléfonos ni documentos).
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && uid() == userId
        && request.resource.data.role in ['elderly', 'volunteer']
        && request.resource.data.status ==
           (request.resource.data.role == 'volunteer' ? 'pending' : 'active')
        && request.resource.data.get('emailVerified', false) == false;
      allow update: if signedIn() && (
        // RF3: coordinación no puede activar a un voluntario pendiente si su correo no está verificado.
        (isCoordinator()
          && (!(resource.data.role == 'volunteer' && resource.data.status == 'pending'
                && request.resource.data.status == 'active')
              || resource.data.get('emailVerified', false) == true))
        || (uid() == userId
            && request.resource.data.role == resource.data.role
            && (request.resource.data.status == resource.data.status
                || request.resource.data.status == 'deleted')
            // RF3: solo se puede marcar el correo como verificado si Firebase lo certifica.
            && (request.resource.data.get('emailVerified', false) == resource.data.get('emailVerified', false)
                || (request.resource.data.get('emailVerified', false) == true
                    && request.auth.token.email_verified == true)))
        // Al terminar una llamada se actualiza al voluntario (disponibilidad y última llamada).
        || (resource.data.role == 'volunteer' && changedOnly(['available', 'lastCallAt']))
      );
    }

    // Datos personales: solo la propia persona y coordinación.
    match /private/{userId} {
      allow read: if signedIn() && (uid() == userId || isCoordinator());
      allow create, update, delete: if signedIn() && uid() == userId;
    }

    match /requests/{requestId} {
      allow read: if signedIn() && (
        resource.data.elderlyId == uid()
        || resource.data.volunteerId == uid()
        || isCoordinator()
        // Respaldo por código: un voluntario activo puede buscar solicitudes abiertas.
        || (isActiveVolunteer() && resource.data.status in ['searching', 'ringing'])
      );
      allow create: if signedIn() && request.resource.data.elderlyId == uid();
      allow update: if signedIn() && (
        resource.data.elderlyId == uid()
        || resource.data.volunteerId == uid()
        || isCoordinator()
        || (isActiveVolunteer()
            && resource.data.status in ['searching', 'ringing']
            && request.resource.data.volunteerId == uid())
      );
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == uid();
      allow read: if signedIn() && (resource.data.reporterId == uid() || isCoordinator());
      allow update: if isCoordinator();
    }

    match /alerts/{alertId} {
      allow create: if signedIn() && request.resource.data.triggeredById == uid();
      allow read: if signedIn() && (resource.data.triggeredById == uid() || isCoordinator());
    }

    match /surveys/{surveyId} {
      allow create, update: if signedIn() && request.resource.data.userId == uid();
      allow read: if signedIn() && (resource.data.userId == uid() || isCoordinator());
    }

    // Evidencia del consentimiento: se crea una vez y no se modifica ni se borra.
    match /consents/{userId} {
      allow create: if signedIn() && uid() == userId;
      allow read: if signedIn() && (uid() == userId || isCoordinator());
    }

    match /slots/{slotId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.volunteerId == uid();
      allow update: if signedIn()
        && resource.data.volunteerId == uid() && request.resource.data.volunteerId == uid();
      allow delete: if signedIn() && resource.data.volunteerId == uid();
    }

    // Contador de intentos fallidos (RF23). Solo es un aviso de la app: la protección real
    // contra fuerza bruta la hace Firebase Auth en el servidor. Se puede leer un documento
    // concreto antes de iniciar sesión, pero NO listar la colección, y solo se aceptan los
    // dos campos esperados. Borrarlo exige sesión iniciada.
    match /locks/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['failedAttempts', 'lockedUntil'])
        && request.resource.data.failedAttempts is int
        && request.resource.data.failedAttempts >= 0
        && request.resource.data.failedAttempts <= 10
        && (request.resource.data.lockedUntil == null || request.resource.data.lockedUntil is string);
      allow delete: if signedIn();
    }
  }
}
