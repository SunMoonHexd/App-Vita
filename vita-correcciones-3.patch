@@ -1,3 +1,5 @@
+import 'dart:async';
+
 import 'package:flutter/material.dart';
 import 'package:vita_app/ui/core/theme/vita_theme.dart';
 import 'package:vita_app/domain/models/vita_models.dart';
@@ -16,9 +18,23 @@ class VolunteerHomeView extends StatefulWidget {
 
 class _VolunteerHomeViewState extends State<VolunteerHomeView> {
   final _code = TextEditingController();
+  Timer? _presence;
+
+  @override
+  void initState() {
+    super.initState();
+    // Latido: cada 20 s avisa que este celular sigue con la app abierta.
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (mounted) VitaScope.of(context).touchPresence();
+    });
+    _presence = Timer.periodic(const Duration(seconds: 20), (_) {
+      if (mounted) VitaScope.of(context).touchPresence();
+    });
+  }
 
   @override
   void dispose() {
+    _presence?.cancel();
     _code.dispose();
     super.dispose();
   }
diff --git a/test/vita_user_test.dart b/test/vita_user_test.dart
new file mode 100644
index 0000000..1b510ff
--- /dev/null
+++ b/test/vita_user_test.dart
@@ -0,0 +1,45 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:vita_app/domain/models/vita_models.dart';
+
+void main() {
+  group('Presencia del voluntario (lastSeenAt)', () {
+    test('se guarda en UTC y se lee como el mismo instante', () {
+      final seen = DateTime(2026, 10, 12, 14, 0);
+      final user = VitaUser(
+        id: 'v1',
+        role: UserRole.volunteer,
+        displayName: 'Vol',
+        status: AccountStatus.active,
+        available: true,
+        lastSeenAt: seen,
+      );
+      final json = user.toJson();
+      expect(json['lastSeenAt'] as String, endsWith('Z'));
+      final back = VitaUser.fromJson(json);
+      expect(back.lastSeenAt!.isAtSameMomentAs(seen), isTrue);
+    });
+
+    test('un usuario sin latido tiene lastSeenAt nulo', () {
+      final user = VitaUser(
+        id: 'v1',
+        role: UserRole.volunteer,
+        displayName: 'Vol',
+        status: AccountStatus.active,
+      );
+      expect(user.lastSeenAt, isNull);
+      expect(VitaUser.fromJson(user.toJson()).lastSeenAt, isNull);
+    });
+
+    test('copyWith conserva el latido anterior si no se indica uno nuevo', () {
+      final seen = DateTime(2026, 10, 12, 14, 0);
+      final user = VitaUser(
+        id: 'v1',
+        role: UserRole.volunteer,
+        displayName: 'Vol',
+        status: AccountStatus.active,
+        lastSeenAt: seen,
+      );
+      expect(user.copyWith(available: false).lastSeenAt, seen);
+    });
+  });
+}
